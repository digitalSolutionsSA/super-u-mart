# Copy to .env for local development (never commit .env).
# Easier alternative: run `netlify link` once, then `npm run dev:netlify`
# loads these from your Netlify site automatically.

# --- Website (browser) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Netlify functions (server only) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_TOKEN=

# Yoco
YOCO_SECRET_KEY=sk_test_
YOCO_WEBHOOK_SECRET=whsec_

# Emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@your-verified-domain.co.za
ORDER_NOTIFICATION_TO=
CUSTOMER_REPLY_TO=

# The Courier Guy live rates (optional; table rates used if unset)
TCG_API_KEY=
TCG_API_BASE=https://api-tcg.shiplogic.com
TCG_SERVICE_LEVEL=ECO
TCG_COLLECTION_COMPANY=Super U Mart
TCG_COLLECTION_STREET=
TCG_COLLECTION_SUBURB=
TCG_COLLECTION_CITY=Vereeniging
TCG_COLLECTION_PROVINCE=Gauteng
TCG_COLLECTION_POSTAL_CODE=
VOLUMETRIC_DIVISOR=5000

# WhatsApp owner alert (optional)
